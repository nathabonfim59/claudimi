#!/bin/bash

# claudimi version — single source of truth; keep in sync with git tags
# (CI verifies the tag matches this on release). Bump here, then tag vX.Y.Z.
CLAUDE_KIMI_VERSION="1.2.0"

# Handle our own flags before delegating to claude
for arg in "$@"; do
    case "$arg" in
        --version|-V)
            echo "claude-kimi ${CLAUDE_KIMI_VERSION}"
            exit 0
            ;;
    esac
done

# Kimi Coding bindings
export ANTHROPIC_API_KEY="${KIMI_API_KEY:-}"
export ANTHROPIC_BASE_URL=https://api.kimi.ai/coding/

# Tier mapping — K3 powers the opus/sonnet tiers, K3.1 Pro the fable tier,
# and K2.8 Preview (kimi-for-coding) backs the fast haiku tier.
#
# Claude Code strips the "[1m]" suffix before sending (it's a client-side
# context-window hint), so "k3" and "k3[1m]" reach Kimi as the same model
# but stay distinct modelSettings keys in settings.json. Per-tier effort
# defaults need distinct keys: opus carries the [1m] suffix at high, sonnet
# uses the k3-256k pin (same model, 256k context) at low for speed, and
# fable runs the K3.1 Pro flagship at xhigh.
# CLAUDE_CODE_MAX_CONTEXT_TOKENS below keeps every tier on the 1M window.
export ANTHROPIC_DEFAULT_OPUS_MODEL="k3[1m]"
export ANTHROPIC_DEFAULT_SONNET_MODEL="k3-256k"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="kimi-for-coding"
export ANTHROPIC_DEFAULT_FABLE_MODEL="kimi-k3.1-pro"

# Kimi's highspeed variant stays selectable in the /model picker
# (256k context, Pro+ plans only)
export ANTHROPIC_CUSTOM_MODEL_OPTION="kimi-for-coding-highspeed"
export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME="Kimi Highspeed"
export ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION="Fast Kimi variant (256k context)"
export ANTHROPIC_CUSTOM_MODEL_OPTION_SUPPORTED_CAPABILITIES="effort"

# Kimi IDs are unknown to Claude Code, so effort must be forced on for the
# per-tier levels in settings.json (modelSettings) to be sent at all.
# Kimi maps them: low -> low, medium/high -> high, xhigh/max -> max.
export CLAUDE_CODE_ALWAYS_ENABLE_EFFORT=1

# Auto mode's no-charge server-side classifier checks are an Anthropic-server
# feature and can't work behind Kimi's gateway (the "this session isn't
# eligible" notice). This stops Claude Code from asking for them; classifier
# checks still run as regular model requests billed to Kimi — never an
# Anthropic subscription.
export CLAUDE_CODE_AUTO_MODE_SERVER=0

# 1M context for opus/fable/haiku (k3[1m], kimi-k3.1-pro, and kimi-for-coding
# all serve 1M). Sonnet's k3-256k pin really caps at 256k; switch tiers for
# marathon sessions.
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="1048576"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="1048576"

export CLAUDE_CONFIG_DIR="${HOME}/.claudimi"
mkdir -p "${CLAUDE_CONFIG_DIR}"

# Run claude
claude "$@"
